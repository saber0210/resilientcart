{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP requests / second",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum by (service) (rate(resilientcart_http_requests_total[1m]))", "legendFormat": "{{service}}", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "p95 HTTP latency",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, service) (rate(resilientcart_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{service}}", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Events processed / second",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "sum by (service, event_type, result) (rate(resilientcart_events_processed_total[1m]))", "legendFormat": "{{service}} · {{event_type}} · {{result}}", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Outbox publish failures",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "sum by (service) (resilientcart_outbox_publish_failures_total)", "legendFormat": "{{service}}", "refId": "A"}]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["resilientcart", "system-design"],
  "templating": {"list": []},
  "time": {"from": "now-15m", "to": "now"},
  "timezone": "browser",
  "title": "ResilientCart Overview",
  "uid": "resilientcart-overview",
  "version": 1
